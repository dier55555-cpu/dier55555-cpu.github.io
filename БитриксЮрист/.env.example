# Скопировать в .env на VPS. В git не коммитить.

# Входящий вебхук Битрикс (не OAuth Нои)
BITRIX_WEBHOOK_URL=https://YOUR_PORTAL.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/

# Воронка и стадии (crm.category.list / crm.status.list)
BITRIX_CATEGORY_ID=0
BITRIX_STAGE_IDS=C0:NEW,C0:PREPARATION

# Пользовательские поля сделки
UF_CASE_NUMBER=UF_CRM_XXXXXXXX
UF_COURT_SLUG=UF_CRM_YYYYYYYY
UF_LAST_STATUS=UF_CRM_ZZZZZZZZ
UF_LAST_CHECK_AT=UF_CRM_AAAAAAAA
UF_SNAPSHOT_HASH=UF_CRM_BBBBBBBB

# Копия парсера БитриксЮриста (не Аннин :8080)
COURT_KB_API_URL=http://127.0.0.1:8081
COURT_KB_API_KEY=

# Этот сервис
BITRIX_YURIST_API_KEY=
DRY_RUN=1
COMMENT_ONLY_ON_CHANGE=1
PAUSE_BETWEEN_DEALS_SEC=5
TZ=Europe/Moscow
