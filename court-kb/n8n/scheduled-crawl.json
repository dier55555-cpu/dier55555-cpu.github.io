{
  "name": "Суды Воронежа — ночной обход сайтов (слой 1)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Каждую ночь в 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.COURT_KB_API_URL || 'http://127.0.0.1:8080') + '/crawl?max_pages=60&max_depth=2' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.COURT_KB_API_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "trigger-crawl",
      "name": "POST /crawl",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "minutes"
      },
      "id": "wait-node",
      "name": "Подождать 15 минут",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.COURT_KB_API_URL || 'http://127.0.0.1:8080') + '/crawl/status' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.COURT_KB_API_KEY}}"
            }
          ]
        }
      },
      "id": "check-status",
      "name": "GET /crawl/status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.COURT_KB_API_URL || 'http://127.0.0.1:8080') + '/corpus/export' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.COURT_KB_API_KEY}}"
            }
          ]
        }
      },
      "id": "export-corpus",
      "name": "GET /corpus/export",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Каждую ночь в 03:00": {
      "main": [
        [
          {
            "node": "POST /crawl",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /crawl": {
      "main": [
        [
          {
            "node": "Подождать 15 минут",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Подождать 15 минут": {
      "main": [
        [
          {
            "node": "GET /crawl/status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /crawl/status": {
      "main": [
        [
          {
            "node": "GET /corpus/export",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
