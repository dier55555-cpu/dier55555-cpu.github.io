{
  "name": "court-kb: case lookup webhook (только слой 2)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "court-case-lookup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook (агент дёргает сюда)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "court-case-lookup"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.COURT_KB_API_URL || 'http://127.0.0.1:8080') + '/case-lookup' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.COURT_KB_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ court_slug: $json.body.court_slug, case_number: $json.body.case_number, last_name: $json.body.last_name, production_type: $json.body.production_type || 'civil_first_instance' }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "call-court-kb-api",
      "name": "HTTP Request -> court-kb API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: $json.status, result: $json.result } }}",
        "options": {}
      },
      "id": "respond-to-webhook",
      "name": "Ответ агенту",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Webhook (агент дёргает сюда)": {
      "main": [
        [
          {
            "node": "HTTP Request -> court-kb API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request -> court-kb API": {
      "main": [
        [
          {
            "node": "Ответ агенту",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
