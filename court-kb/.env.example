# Скопируйте в .env рядом с docker-compose.yml и заполните.
# docker compose автоматически подхватит этот файл.

# Обязателен, если API доступен не только из внутренней сети n8n.
# Тот же ключ задайте в переменных окружения n8n (COURT_KB_API_KEY).
COURT_KB_API_KEY=смените-на-случайную-строку

# HTTP(S)-прокси с российским IP. Оставьте пустым, если сервер НОЕ/n8n
# сам находится в РФ и сайты судов с него открываются.
# COURT_KB_PROXY=http://user:pass@ru-proxy-host:port
COURT_KB_PROXY=

# Ключ 2captcha/rucaptcha — нужен, если на форме поиска дела есть капча.
# TWOCAPTCHA_API_KEY=your-key
TWOCAPTCHA_API_KEY=
