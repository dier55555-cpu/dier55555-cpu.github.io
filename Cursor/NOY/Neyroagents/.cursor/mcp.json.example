{
  "_comment": "Скопировать в mcp.json. Ключ только в Secrets. Не коммитить mcp.json с nk_live.",
  "mcpServers": {
    "noya-neyroagents": {
      "command": "npx",
      "args": ["-y", "https://noya-ai.ru/mcp/0.10.1/noya-mcp.tgz"],
      "env": {
        "NOYA_API_KEY": "${env:NOYA_KEY_NEYROAGENTS}"
      }
    }
  }
}
