{
  "_comment": "Скопировать в mcp.json (он в gitignore). Ключ только в Secrets: NOYA_KEY_NEYROAGENTS. Не брать ключ ДендрИИт. Актуальный package_url: GET https://noya-ai.ru/api/mcp-info",
  "mcpServers": {
    "noya-neyroagents": {
      "command": "npx",
      "args": ["-y", "https://noya-ai.ru/mcp/0.10.3/noya-mcp.tgz"],
      "env": {
        "NOYA_API_KEY": "${env:NOYA_KEY_NEYROAGENTS}"
      }
    }
  }
}
