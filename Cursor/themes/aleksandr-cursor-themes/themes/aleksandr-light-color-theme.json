    "sideBarSectionHeader.foreground": "#3d4a5f",
    "sideBarSectionHeader.border": "#dde2ea",

    "activityBar.background": "#e4e8ef",
    "activityBar.foreground": "#1a2332",
    "activityBar.inactiveForeground": "#7a8499",
    "activityBar.border": "#dde2ea",
    "activityBarBadge.background": "#2b6cb0",
    "activityBarBadge.foreground": "#ffffff",

    "titleBar.activeBackground": "#e4e8ef",
    "titleBar.activeForeground": "#1a2332",
