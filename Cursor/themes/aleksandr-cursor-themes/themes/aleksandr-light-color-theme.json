    "terminal.ansiBrightGreen": "#38a169",
    "terminal.ansiBrightYellow": "#d69e2e",
    "terminal.ansiBrightBlue": "#3182ce",
    "terminal.ansiBrightMagenta": "#9f7aea",
    "terminal.ansiBrightCyan": "#319795",
    "terminal.ansiBrightWhite": "#1a2332",

