    "scrollbarSlider.background": "#b8c0d066",
    "scrollbarSlider.hoverBackground": "#9aa3b599",
    "scrollbarSlider.activeBackground": "#7a8499aa",

    "gitDecoration.modifiedResourceForeground": "#2b6cb0",
    "gitDecoration.untrackedResourceForeground": "#2f855a",
    "gitDecoration.deletedResourceForeground": "#c53030",
    "gitDecoration.ignoredResourceForeground": "#9aa3b5",
    "gitDecoration.conflictingResourceForeground": "#b7791f",

    "peekView.border": "#2b6cb0",
    "peekViewEditor.background": "#f0f4f8",
    "peekViewResult.background": "#eef1f6",
    "peekViewTitle.background": "#e4e8ef"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#1a2332" },
      "scope": ["source", "text"]
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7a8499", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#2f855a" }
    },
    {
      "name": "Number / Constant",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#b7791f" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#805ad5" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#2b6cb0" }
    },
    {
      "name": "Class / Type",
      "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#b7791f" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#1a2332" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#c05621" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#2c7a7b" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#c53030" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#b7791f" }
    },
    {
      "name": "Operator / Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#4a5568" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#2b6cb0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#2c7a7b" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c53030" }
    }
  ]
}
