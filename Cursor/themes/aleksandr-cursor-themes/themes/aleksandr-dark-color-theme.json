  "tokenColors": [
    {
      "settings": { "foreground": "#d7dde8" },
      "scope": ["source", "text"]
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5a6578", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#7fd992" }
    },
    {
      "name": "Number / Constant",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#e6c07b" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#c792ea" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#5eb1ff" }
    },
    {
      "name": "Class / Type",
      "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#e6c07b" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#d7dde8" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#f0a06a" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#f07178" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#e6c07b" }
    },
    {
      "name": "Operator / Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#a8b2c4" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#5eb1ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f07178" }
    }
  ]
}
