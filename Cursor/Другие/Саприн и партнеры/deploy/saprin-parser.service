[Unit]
Description=Saprin court parser API (:8081)
After=network.target

[Service]
Type=simple
User=saprin
Group=saprin
WorkingDirectory=/opt/saprin/parser
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/saprin/parser/.env
ExecStart=/opt/saprin/venv/bin/uvicorn api.delo_app:app --host 127.0.0.1 --port 8081 --workers 1
Restart=always
RestartSec=3
MemoryMax=500M

[Install]
WantedBy=multi-user.target
