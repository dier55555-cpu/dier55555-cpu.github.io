[Unit]
Description=Saprin Bitrix job — daily stages (Mon–Fri 08:30)
After=network-online.target saprin-parser.service
Wants=network-online.target saprin-parser.service

[Service]
Type=oneshot
User=saprin
Group=saprin
WorkingDirectory=/opt/saprin/job
EnvironmentFile=/opt/saprin/job/.env
Environment=TZ=Europe/Moscow
Environment=BITRIX_STAGE_IDS=C2:UC_GZ6RL3,C2:UC_YJ087T,C2:UC_2M4FYU,C2:UC_B2ZGR1,C2:UC_ILS0X3
ExecStart=/opt/saprin/venv/bin/python /opt/saprin/job/bitrix.py
Nice=10
